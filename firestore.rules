rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isAdmin() { return signedIn() && profile().data.role == 'admin'; }
    function isCommercial() { return signedIn() && profile().data.role == 'commercial'; }
    function isStaff() { return isAdmin() || isCommercial(); }
    function validQtyDecrease() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['qty'])
        && request.resource.data.qty is number
        && request.resource.data.qty >= 0
        && request.resource.data.qty <= resource.data.qty;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // Création et modification des rôles uniquement via console Firebase/admin fiable.
      allow write: if isAdmin();
    }

    // Stock, bocaux et produits communs. Le commercial ne peut diminuer que la quantité disponible.
    match /jars/{id} { allow read: if isStaff(); allow write: if isAdmin(); }
    match /bottlings/{id} { allow read: if isStaff(); allow write: if isAdmin(); }
    match /products/{id} {
      allow read: if isStaff();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isCommercial() && validQtyDecrease());
    }
    match /lots/{id} {
      allow read: if isStaff();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isCommercial() && validQtyDecrease());
    }

    // Un commercial crée uniquement ses propres ventes et ne peut pas modifier/supprimer les ventes ensuite.
    match /sales/{id} {
      allow read: if isAdmin() || (isCommercial() && resource.data.uid == request.auth.uid);
      allow create: if isStaff() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    match /config/{id} { allow read: if isStaff(); allow write: if isAdmin(); }
    match /{document=**} { allow read, write: if false; }
  }
}
